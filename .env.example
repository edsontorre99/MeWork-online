# Base de datos MySQL. Formato:
#   mysql://USUARIO:CONTRASEÑA@HOST:3306/NOMBRE_BASE
# Si la contraseña tiene símbolos, hay que codificarlos:
#   # → %23   @ → %40   / → %2F   : → %3A   ? → %3F   & → %26   % → %25   espacio → %20
# Ejemplo: contraseña "Ab#12@x" → mysql://u123_mework:Ab%2312%40x@srv123.hstgr.io:3306/u123_mework
DATABASE_URL="mysql://USUARIO:CONTRASEÑA@HOST:3306/NOMBRE_BASE"

# Credenciales de acceso a TORAM HUB
AUTH_USER="edson"
AUTH_PASSWORD="tu-contraseña"

# Secreto para firmar la sesión (JWT). Cámbialo en producción.
JWT_SECRET="genera-un-secreto-largo-y-aleatorio"

# Opcional: API Key de Gemini por defecto (también se puede guardar en Ajustes)
GEMINI_API_KEY=""

# Llave para cifrar las contraseñas de aplicación de Gmail (32 bytes en base64).
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la cambias, tendrás que volver a conectar tus cuentas de correo.
MAIL_ENCRYPTION_KEY=""

# Secreto para llamar a /api/cron/revisar-correo desde un servidor (encabezado Authorization: Bearer <secreto>)
CRON_SECRET=""
